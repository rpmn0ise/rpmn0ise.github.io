---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="fr">
  <title>{{ site.titre }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ '/feed.xml' | absoluteUrl(site.url) }}" rel="self"/>
  <link href="{{ site.url }}/"/>
  <updated>{{ collections.journal | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ site.auteur.nom }}</name>
  </author>
  {%- for post in collections.journal | limite(20) %}
  {%- set urlArticle = post.url | absoluteUrl(site.url) %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ urlArticle }}"/>
    <updated>{{ post.date | dateToRfc3339 }}</updated>
    <id>{{ urlArticle }}</id>
    {%- if post.data.description %}
    <summary>{{ post.data.description }}</summary>
    {%- endif %}
    <content xml:lang="fr" type="html">{{ post.templateContent | htmlToAbsoluteUrls(urlArticle) }}</content>
  </entry>
  {%- endfor %}
</feed>
