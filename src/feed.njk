---
pagination:
  data: langues
  size: 1
  alias: L
permalink: "{{ i18n[L].routes.flux }}"
eleventyComputed:
  lang: "{{ L }}"
eleventyExcludeFromCollections: true
---
{%- set j = collections["journal-" + lang] -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ lang }}">
  <title>{{ site.titre }}</title>
  <subtitle>{{ t.site.description }}</subtitle>
  <link href="{{ t.routes.flux | absoluteUrl(site.url) }}" rel="self"/>
  <link href="{{ t.routes.accueil | absoluteUrl(site.url) }}"/>
  <updated>{{ j | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ t.routes.accueil | absoluteUrl(site.url) }}</id>
  <author>
    <name>{{ site.auteur.nom }}</name>
  </author>
  {%- for post in j | limite(20) %}
  {%- set urlArticle = post.url | absoluteUrl(site.url) %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ urlArticle }}"/>
    <updated>{{ post.date | dateToRfc3339 }}</updated>
    <id>{{ urlArticle }}</id>
    {%- if post.data.description %}
    <summary>{{ post.data.description }}</summary>
    {%- endif %}
    <content xml:lang="{{ lang }}" type="html">{{ post.templateContent | htmlToAbsoluteUrls(urlArticle) }}</content>
  </entry>
  {%- endfor %}
</feed>
