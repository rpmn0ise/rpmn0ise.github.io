<article class="post-card">
  {% if post.data.image %}
    <a href="{{ post.url }}" class="post-card__image-link" tabindex="-1" aria-hidden="true">
      <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt or post.data.title }}" loading="lazy" decoding="async" class="post-card__image">
    </a>
  {% endif %}
  <div class="post-card__content">
    {% if post.data.tags %}
      <div class="post-card__tags">
        {% for tag in post.data.tags %}
          {% if tag != "post" and tag != "posts" %}
            <a href="/tags/{{ tag | slugify }}/" class="tag">{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
    <h2 class="post-card__title">
      <a href="{{ post.url }}" class="post-card__link">{{ post.data.title }}</a>
    </h2>
    {% if post.data.description %}
      <p class="post-card__excerpt">{{ post.data.description }}</p>
    {% endif %}
    <footer class="post-card__footer">
      <time datetime="{{ post.date | htmlDateString }}" class="post-card__date">
        {{ post.date | readableDate }}
      </time>
      <span class="post-card__reading-time">{{ post.content | readingTime }}</span>
      {% if post.data.draft %}
        <span class="draft-label">brouillon</span>
      {% endif %}
    </footer>
  </div>
</article>
