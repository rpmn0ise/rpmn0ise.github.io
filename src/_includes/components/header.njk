<header class="site-header" role="banner">
  <div class="container">
    <div class="site-header__inner">

      <a href="/" class="site-logo" aria-label="{{ site.title }} — Accueil">
        <span class="site-logo__mark" aria-hidden="true">&lt;/&gt;</span>
        <span class="site-logo__name">{{ site.title }}</span>
      </a>

      <nav class="site-nav" id="site-nav" aria-label="Navigation principale">
        <ul class="site-nav__list" role="list">
          {% for item in site.nav %}
            <li class="site-nav__item">
              <a href="{{ item.url }}"
                 class="site-nav__link {% if page.url == item.url or page.url.startsWith(item.url) and item.url != '/' %}site-nav__link--active{% endif %}"
                 {% if page.url == item.url %}aria-current="page"{% endif %}>
                {{ item.label }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </nav>

      <div class="site-header__actions">
        <button class="theme-toggle" id="theme-toggle" aria-label="Basculer le thème" title="Basculer clair/sombre">
          <svg class="theme-toggle__icon theme-toggle__icon--sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg class="theme-toggle__icon theme-toggle__icon--moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

        <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Ouvrir le menu">
          <span></span><span></span><span></span>
        </button>
      </div>

    </div>
  </div>
</header>
