{% set latestEntry = collections.entries | first %}
<header class="site-header" role="banner">
  <div class="container site-header__inner">

    <a href="/" class="brand-lockup">
      <span class="brand-lockup__name">{{ site.title }}</span>
      <span class="brand-lockup__divider" aria-hidden="true">/</span>
      <span class="brand-lockup__tagline">Digital Laboratory</span>
    </a>

    <button
      class="header-trigger"
      id="nav-trigger"
      aria-expanded="false"
      aria-controls="nav-panel"
      aria-label="Ouvrir la navigation du labo"
    >
      {% if latestEntry %}
        <span class="status-line">
          <span class="status-line__dot" aria-hidden="true">◍</span>
          dernière trace : {{ latestEntry.date | timeAgo }}
        </span>
        <span class="status-line__sep" aria-hidden="true">·</span>
      {% endif %}
      <span class="status-line status-line--count">
        №{{ collections.labStats.totalEntries }}
      </span>
      <span class="header-trigger__bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>

  </div>
</header>
