{# Composant lab-margin — annotations de cahier de labo pour post.njk / project.njk.
   Ne requiert aucun setup côté appelant : calcule tout depuis le scope
   déjà disponible dans les layouts de contenu (content, date, domain, tags,
   annotations, page, collections). #}

{% set currentEntry = { url: page.url, data: { domain: domain, tags: tags } } %}

{% set headings = content | extractHeadings %}
{% set domainData = domain | domainInfo %}
{% set relatedSameDomain = currentEntry | sameDomainEntries(collections.entries, 4) %}

<aside class="lab-margin" aria-label="Marge de laboratoire">

  {% if annotations and annotations.length %}
    <div class="lab-margin__block">
      <p class="lab-margin__label">Notes</p>
      {% for note in annotations %}
        {% include "components/margin-note.njk" %}
      {% endfor %}
    </div>
  {% endif %}

  {% if headings.length %}
    <nav class="lab-margin__block lab-margin__toc" aria-label="Sommaire">
      <p class="lab-margin__label">Sommaire</p>
      <ol class="toc-list" id="toc-list">
        {% for h in headings %}
          <li class="toc-list__item toc-list__item--h{{ h.level }}">
            <a href="#{{ h.id }}" data-toc-link data-toc-target="{{ h.id }}">{{ h.text }}</a>
          </li>
        {% endfor %}
      </ol>
    </nav>
  {% endif %}

  <div class="lab-margin__block">
    <p class="lab-margin__label">Informations</p>
    <dl class="lab-margin__meta">
      <dt>Lecture</dt>
      <dd>{{ content | readingTime }} min</dd>

      <dt>Publié</dt>
      <dd><time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time></dd>

      {% if domainData %}
        <dt>Domaine</dt>
        <dd><a href="/domaines/{{ domainData.id }}/">{{ domainData.label }}</a></dd>
      {% endif %}

      {% if tags and tags.length %}
        <dt>Tags</dt>
        <dd class="lab-margin__tags">
          {% for t in tags %}
            {% if t != "post" and t != "posts" %}
              <a href="/tags/{{ t | slugify }}/">#{{ t }}</a>
            {% endif %}
          {% endfor %}
        </dd>
      {% endif %}
    </dl>
  </div>

  {% if relatedSameDomain.length %}
    <div class="lab-margin__block">
      <p class="lab-margin__label">Articles liés</p>
      <ul class="lab-margin__related">
        {% for r in relatedSameDomain %}
          <li>
            <a href="{{ r.url }}">{{ r.data.title }}</a>
            <time datetime="{{ r.date | htmlDateString }}">{{ r.date | readableDate("dd MMM yyyy") }}</time>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

</aside>
