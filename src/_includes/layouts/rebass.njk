---
layout: base.njk
---

<div class="container">

  <header class="page-header">
    <h1 class="page-header__title">{{ title }}</h1>
    {% if description %}
      <p class="page-header__description">{{ description }}</p>
    {% endif %}
    {% if content %}
      <div class="prose" style="margin-top: var(--space-4);">{{ content | safe }}</div>
    {% endif %}
  </header>

  {% if tracks and tracks.length %}
    <div class="rebass-stats">
      <span class="rebass-stats__item">
        <strong>{{ tracks.length }}</strong> morceau{% if tracks.length > 1 %}x{% endif %}
      </span>
      <span class="rebass-stats__sep">·</span>
      <span class="rebass-stats__item">Logiciel : <strong>Audacity</strong></span>
    </div>

    <div class="rebass-grid">
      {% for track in tracks %}
        <article class="rebass-card">
          <div class="rebass-card__header">
            <div class="rebass-card__meta">
              {% if track.plateforme == "youtube" %}
                <span class="rebass-badge rebass-badge--youtube">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.54 3.5 12 3.5 12 3.5s-7.54 0-9.38.55A3.02 3.02 0 0 0 .5 6.19C0 8.04 0 12 0 12s0 3.96.5 5.81a3.02 3.02 0 0 0 2.12 2.14C4.46 20.5 12 20.5 12 20.5s7.54 0 9.38-.55a3.02 3.02 0 0 0 2.12-2.14C24 15.96 24 12 24 12s0-3.96-.5-5.81zM9.75 15.52V8.48L15.84 12l-6.09 3.52z"/></svg>
                  YouTube
                </span>
              {% elif track.plateforme == "soundcloud" %}
                <span class="rebass-badge rebass-badge--soundcloud">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M1.175 12.225c-.017 0-.033.002-.05.002.002-.01.004-.02.004-.03a2.4 2.4 0 0 1 4.8 0c0 .01.002.02.003.03-.017 0-.033-.002-.05-.002a2.354 2.354 0 0 0-2.354 2.354v4.292a2.354 2.354 0 1 0 4.708 0V9.579a4.167 4.167 0 0 1 7.617-2.313 5.833 5.833 0 0 1 1.133-.112 5.875 5.875 0 0 1 5.875 5.875 5.875 5.875 0 0 1-5.875 5.875H1.175A1.175 1.175 0 0 1 0 17.729a1.175 1.175 0 0 1 1.175-1.175z"/></svg>
                  SoundCloud
                </span>
              {% else %}
                <span class="rebass-badge rebass-badge--autre">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                  Audio
                </span>
              {% endif %}
            </div>
          </div>

          <div class="rebass-card__body">
            <h2 class="rebass-card__title">{{ track.titre }}</h2>
            <p class="rebass-card__artist">{{ track.artiste }}</p>
          </div>

          <div class="rebass-card__specs">
            {% if track.plage %}
              <div class="rebass-spec">
                <span class="rebass-spec__label">Plage bass</span>
                <span class="rebass-spec__value">{{ track.plage }}</span>
              </div>
            {% endif %}
            {% if track.logiciel %}
              <div class="rebass-spec">
                <span class="rebass-spec__label">Logiciel</span>
                <span class="rebass-spec__value">{{ track.logiciel }}</span>
              </div>
            {% endif %}
            {% if track.note %}
              <div class="rebass-spec rebass-spec--note">
                <span class="rebass-spec__label">Note</span>
                <span class="rebass-spec__value">{{ track.note }}</span>
              </div>
            {% endif %}
          </div>

          {% if track.lien %}
            <a href="{{ track.lien }}" target="_blank" rel="noopener noreferrer" class="rebass-card__link">
              Écouter
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>

  {% else %}
    <p style="color: var(--text-secondary); text-align: center; padding: var(--space-16);">
      Aucun rebass publié pour l'instant.
    </p>
  {% endif %}

</div>
