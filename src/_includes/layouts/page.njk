---
layout: base.njk
---

<div class="container">
  <header class="page-header">
    <h1 class="page-header__title">{{ title }}</h1>
    {% if description %}
      <p class="page-header__description">{{ description }}</p>
    {% endif %}
  </header>

  <div class="prose" style="padding-bottom: var(--space-16);">
    {{ content | safe }}
  </div>
</div>
