---
layout: base.njk
ogType: article
---

<article class="container">

  <header class="page-header">
    <p class="page-header__eyebrow">Spécimen №{{ page | entryId(collections.entries) }}</p>
    <div style="display:flex; align-items:center; gap: var(--space-3); margin-bottom: var(--space-3); flex-wrap: wrap;">
      {% set domainId = domain %}{% include "components/domain-pill.njk" %}
      {% if status %}{% set statusValue = status %}{% include "components/status-tag.njk" %}{% endif %}
      {% if year %}
        <span style="font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-muted);">depuis {{ year }}</span>
      {% endif %}
    </div>

    <h1 class="page-header__title">{{ title }}</h1>

    {% if description %}
      <p class="page-header__description">{{ description }}</p>
    {% endif %}

    <div style="margin-top: var(--space-5); display: flex; gap: var(--space-3); flex-wrap: wrap;">
      {% if github %}
        <a href="{{ github }}" class="btn btn--outline" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      {% endif %}
      {% if demo %}
        <a href="{{ demo }}" class="btn btn--primary" target="_blank" rel="noopener noreferrer">Voir le projet ↗</a>
      {% endif %}
    </div>
  </header>

  {% if tech or status or access %}
    <section class="section">
      <h2 class="section__title">Nomenclature</h2>
      <dl class="nomenclature">
        {% if tech %}
          <dt>Stack</dt><dd>{{ tech | join(" · ") }}</dd>
        {% endif %}
        {% if status %}
          <dt>Statut</dt><dd>{{ status | replace("-", " ") }}</dd>
        {% endif %}
        {% if access %}
          <dt>Accès</dt><dd>{{ access }}</dd>
        {% endif %}
      </dl>
    </section>
  {% endif %}

  <div class="project-detail__body prose section">
    {{ content | safe }}
  </div>

  {% if log and log.length %}
    <section class="section">
      <h2 class="section__title">Journal d'expérimentation</h2>
      {% include "components/timeline.njk" %}
    </section>
  {% endif %}

  {% if nextSteps and nextSteps.length %}
    <section class="section">
      <h2 class="section__title">Prochaines étapes</h2>
      <ul class="prose" style="padding-left: var(--space-6); list-style: disc;">
        {% for step in nextSteps %}
          <li>{{ step }}</li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% set related = page | relatedEntries(collections.entries) %}
  {% if related.length %}
    <section class="section">
      <h2 class="section__title">Entrées liées</h2>
      <div class="entry-list">
        {% for entry in related %}
          {% include "components/entry-card.njk" %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

</article>
