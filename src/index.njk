---
layout: base.njk
avecMusique: true
---
<section class="hero">
  <p class="hero__etiquette etiquette"><b>//</b> Accueil</p>
  <h1 class="hero__nom">{{ site.titre | replace("0", "<em>0</em>") | safe }}</h1>
  {%- if citations.length %}
  {#- Une citation au hasard à chaque chargement. Sans JavaScript, la phrase d'accueil reste affichée. #}
  <figure class="hero__citation" data-citation>
    <blockquote class="hero__texte"><p>{{ site.accroche }}</p></blockquote>
    <figcaption class="hero__auteur meta" hidden></figcaption>
  </figure>
  <script type="application/json" id="citations-donnees">{{ citations | dump | replace("<", "\\u003c") | safe }}</script>
  <script>
  (function () {
    var f = document.querySelector("[data-citation]"), d = document.getElementById("citations-donnees");
    if (!f || !d) return;
    try {
      var l = JSON.parse(d.textContent);
      if (!l.length) return;
      var i = Math.floor(Math.random() * l.length), p = -1;
      try { p = parseInt(sessionStorage.getItem("citation"), 10); } catch (e) {}
      if (l.length > 1 && i === p) i = (i + 1 + Math.floor(Math.random() * (l.length - 1))) % l.length;
      try { sessionStorage.setItem("citation", String(i)); } catch (e) {}
      var c = l[i], fr = function (s) { return s.replace(/ ([:;!?»])/g, "\u00a0$1").replace(/« /g, "«\u00a0"); };
      f.querySelector("blockquote p").textContent = fr(c.texte);
      var a = f.querySelector("figcaption");
      a.textContent = fr(c.auteur);
      if (c.source) { a.append(" · "); var e = document.createElement("cite"); e.textContent = fr(c.source); a.append(e); }
      a.hidden = false;
      f.classList.add("hero__citation--active");
    } catch (e) {}
  })();
  </script>
  {%- elif site.accroche %}
  <p class="hero__texte">{{ site.accroche }}</p>
  {%- endif %}
  {%- if site.centres.length %}
  <ul class="puces" aria-label="Centres d'intérêt">
    {%- for c in site.centres %}<li>{{ c }}</li>{%- endfor %}
  </ul>
  {%- endif %}
  {%- set aLaUne = collections.projets | misEnAvant %}
  {%- if collections.projets.length or collections.journal.length %}
  <p class="hero__index meta">
    {%- if collections.projets.length %}{{ collections.projets.length }} projet{% if collections.projets.length > 1 %}s{% endif %}{% endif %}
    {%- if collections.projets.length and collections.journal.length %} · {% endif %}
    {%- if collections.journal.length %}{{ collections.journal.length }} entrée{% if collections.journal.length > 1 %}s{% endif %} au journal{% endif %}
  </p>
  {%- endif %}
  {%- if aLaUne.length %}
  <a class="hero__defiler" href="#projets">↓ Projets</a>
  {%- endif %}
</section>

{%- set enCeMoment = maintenant.ecoute or maintenant.joue or maintenant.travaille or maintenant.setup.titre %}
<section class="maintenant" aria-label="En ce moment" data-maintenant{% if not enCeMoment %} hidden{% endif %}>
  <div class="bloc__tete">
    <h2 class="section-titre">En ce moment</h2>
    <a class="suite" href="/musique/">Musique →</a>
  </div>
  <div class="maintenant__grille">
    {%- set grand = false %}{%- set nombre = 1 %}{%- set liste = false %}
    {% include "ecoute.njk" %}
    {%- if maintenant.joue %}
    <div class="maintenant__cellule">
      <p class="etiquette">Joue à</p>
      <p class="maintenant__texte">{{ maintenant.joue }}</p>
    </div>
    {%- endif %}
    {%- if maintenant.travaille %}
    <div class="maintenant__cellule">
      <p class="etiquette">Travaille sur</p>
      <p class="maintenant__texte">{{ maintenant.travaille }}</p>
    </div>
    {%- endif %}
    {%- if maintenant.setup.titre %}
    <a class="maintenant__cellule maintenant__cellule--large" href="/setup/">
      <p class="etiquette">Setup</p>
      <div>
        <p class="maintenant__texte">{{ maintenant.setup.titre }}</p>
        {%- if maintenant.setup.note %}<p class="maintenant__note">{{ maintenant.setup.note }}</p>{%- endif %}
      </div>
    </a>
    {%- endif %}
  </div>
</section>

{%- if aLaUne.length %}
<section class="bloc" id="projets">
  <div class="bloc__tete">
    <h2 class="section-titre">Projets</h2>
    <a class="suite" href="/projets/">Tous les projets →</a>
  </div>
  {%- set projets = aLaUne | limite(3) %}
  {% include "liste-projets.njk" %}
</section>
{%- endif %}

{%- if collections.journal.length %}
<section class="bloc">
  <div class="bloc__tete">
    <h2 class="section-titre">Journal</h2>
    <a class="suite" href="/journal/">Tout le journal →</a>
  </div>
  {%- set entrees = collections.journal | limite(3) %}
  {% include "liste-journal.njk" %}
</section>
{%- endif %}
