---
layout: base.njk
---
<section class="hero">
  <h1 class="hero__nom">{{ site.titre }}</h1>
  {%- if site.accroche %}
  <p class="hero__texte">{{ site.accroche }}</p>
  {%- endif %}
  {%- set aLaUne = collections.projets | misEnAvant %}
  {%- if collections.projets.length or collections.journal.length %}
  <p class="hero__index meta">
    {%- if collections.projets.length %}{{ collections.projets.length }} projet{% if collections.projets.length > 1 %}s{% endif %}{% endif %}
    {%- if collections.projets.length and collections.journal.length %} · {% endif %}
    {%- if collections.journal.length %}{{ collections.journal.length }} entrée{% if collections.journal.length > 1 %}s{% endif %} au journal{% endif %}
  </p>
  {%- endif %}
  {%- if aLaUne.length %}
  <a class="hero__defiler" href="#projets">↓ Projets</a>
  {%- endif %}
</section>

{%- if aLaUne.length %}
<section class="bloc" id="projets">
  <div class="bloc__tete">
    <h2 class="section-titre">Projets</h2>
    <a class="suite" href="/projets/">Tous les projets →</a>
  </div>
  {%- set projets = aLaUne | limite(3) %}
  {% include "liste-projets.njk" %}
</section>
{%- endif %}

{%- if collections.journal.length %}
<section class="bloc">
  <div class="bloc__tete">
    <h2 class="section-titre">Journal</h2>
    <a class="suite" href="/journal/">Tout le journal →</a>
  </div>
  {%- set entrees = collections.journal | limite(3) %}
  {% include "liste-journal.njk" %}
</section>
{%- endif %}
