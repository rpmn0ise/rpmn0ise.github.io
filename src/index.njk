---
layout: base.njk
title: Accueil
description: Développeur, créateur, explorateur de technologies modernes.
eleventyNavigation:
  key: Accueil
  order: 1
---

{# ─── Hero ─── #}
<section class="hero">
  <div class="container">

    <div class="hero__eyebrow animate-fade-up">
      <span>◈</span> &nbsp;Dev · Audio · Linux · Simulation
    </div>

    <h1 class="hero__title animate-fade-up animate-fade-up--delay-1">
      Bonjour, je suis<br>
      <span class="accent">{{ site.author.name }}</span>
    </h1>

    <p class="hero__description animate-fade-up animate-fade-up--delay-2">
      {{ site.author.bio }}
    </p>

    <div class="hero__actions animate-fade-up animate-fade-up--delay-3">
      <a href="/about/" class="btn btn--primary"><span>À propos de moi</span></a>
      <a href="/blog/" class="btn btn--outline">Lire le blog</a>
      <a href="{{ site.social.github }}" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        GitHub
      </a>
    </div>

    <div class="hero__meta animate-fade-up animate-fade-up--delay-4">
      <span class="hero__meta-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <strong>{{ site.author.location }}</strong>
      </span>
      <span class="hero__meta-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        <strong>{{ collections.posts | length }} articles</strong> publiés
      </span>
      <span class="hero__meta-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <strong>{{ collections.projects | length }} projets</strong>
      </span>
    </div>

  </div>
</section>

{# ─── Latest Posts ─── #}
{% if collections.posts.length %}
<section class="section">
  <div class="container">
    <div class="section__header">
      <div>
        <h2 class="section__title">Derniers articles</h2>
        <p class="section__subtitle">Réflexions, tutoriels et retours d'expérience</p>
      </div>
      <a href="/blog/" class="section__link btn btn--ghost">Tous les articles →</a>
    </div>

    <div class="posts-grid">
      {% for post in collections.posts | limit(6) %}
        {% set post = post %}
        {% include "components/post-card.njk" %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ─── Skills ─── #}
<section class="section">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title">Technologies & Centres d'intérêt</h2>
    </div>
    <div class="skills-grid">
      <div class="skill-item"><span class="skill-item__icon">🐧</span> Arch Linux / Systèmes</div>
      <div class="skill-item"><span class="skill-item__icon">🔊</span> Audio & Sound Systems</div>
      <div class="skill-item"><span class="skill-item__icon">🏎️</span> Simulation (BeamNG.drive)</div>
      <div class="skill-item"><span class="skill-item__icon">🛡️</span> Cybersécurité / Hardening</div>
      <div class="skill-item"><span class="skill-item__icon">🛠️</span> PC Hardware / Performance</div>
      <div class="skill-item"><span class="skill-item__icon">⚡</span> JavaScript / TypeScript</div>
      <div class="skill-item"><span class="skill-item__icon">🔧</span> Eleventy / Markdown</div>
      <div class="skill-item"><span class="skill-item__icon">🏴‍☠️</span> Culture Numérique Libre</div>
    </div>
  </div>
</section>
