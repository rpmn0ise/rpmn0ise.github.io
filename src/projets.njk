---
layout: base.njk
pagination:
  data: langues
  size: 1
  alias: L
  addAllPagesToCollections: true
permalink: "{{ i18n[L].routes.projets }}"
eleventyComputed:
  lang: "{{ L }}"
  translationKey: projets-index
  title: "{{ i18n[L].pages.projets.titre }}"
  description: "{{ i18n[L].pages.projets.description }}"
---
{%- set pr = collections["projets-" + lang] %}
<header class="entete-contenu">
  <h1>{{ t.pages.projets.titre }}</h1>
</header>

{%- if pr.length %}
{%- set projets = pr %}
{% include "liste-projets.njk" %}
{%- else %}
<p class="vide">{{ t.pages.projets.vide }}</p>
{%- endif %}
