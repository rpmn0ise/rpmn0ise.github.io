---
layout: base.njk
pagination:
  data: collections.tagPages
  size: 1
  alias: tag
  addAllPagesToCollections: true
permalink: "{{ tag.url }}"
eleventyComputed:
  lang: "{{ tag.lang }}"
  translationKey: "tag-{{ tag.cle }}"
  title: "#{{ tag.nom }}"
  description: "{{ i18n[tag.lang].pages.tag.description | remplir({ tag: tag.nom }) }}"
---
<header class="entete-contenu">
  <p class="meta"><a class="retour" href="{{ t.routes.journal }}">{{ t.ui.retourJournal }}</a></p>
  <h1>#{{ tag.nom }}</h1>
</header>

{%- set entrees = tag.entrees %}
{% include "liste-journal.njk" %}
