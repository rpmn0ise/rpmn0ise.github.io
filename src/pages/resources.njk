---
layout: base.njk
title: Ressources
description: Une liste curatée d'outils, liens et références que j'utilise ou recommande.
permalink: /resources/
---

<div class="container">

  <header class="blog-header">
    <h1 class="blog-title">Ressources</h1>
    <p class="blog-description">{{ description }}</p>
  </header>

  {# Search #}
  <div class="search-box" role="search" style="margin-bottom: var(--space-8);">
    <svg class="search-box__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input type="search" id="search-input" placeholder="Rechercher une ressource…" aria-label="Rechercher" autocomplete="off">
  </div>

  {% if collections.resources.length %}
    <div class="resources-list">
      {% for resource in collections.resources %}
        <article
          class="resource-item"
          data-search-item="{{ resource.data.title }} {{ resource.data.description }} {{ resource.data.tags | join(' ') }}"
        >
          <span class="resource-item__icon">{{ resource.data.icon or "🔗" }}</span>
          <div class="resource-item__content">
            <h2 class="resource-item__title">
              <a href="{{ resource.data.url or resource.url }}" {% if resource.data.url %}target="_blank" rel="noopener noreferrer"{% endif %}>
                {{ resource.data.title }}
                {% if resource.data.url %}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;margin-left:4px;vertical-align:middle;opacity:.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                {% endif %}
              </a>
            </h2>
            {% if resource.data.description %}
              <p class="resource-item__description">{{ resource.data.description }}</p>
            {% endif %}
            {% if resource.data.tags %}
              <div class="resource-item__tags">
                {% for tag in resource.data.tags %}
                  <span class="tag">{{ tag }}</span>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}

      <p id="no-results" hidden style="color: var(--text-secondary); padding: var(--space-8); text-align:center;">
        Aucun résultat.
      </p>
    </div>
  {% else %}
    <p style="color: var(--text-secondary);">Ressources en cours d'ajout…</p>
  {% endif %}

</div>
