---
layout: base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag | slugify }}/
title: "Tag : {{ tag }}"
---

<div class="container">
  <header class="page-header">
    <p class="page-header__eyebrow"><a href="/blog/">← Le Labo</a> · Tag</p>
    {% set taggedEntries = collections.entries | whereContains("data.tags", tag) %}
    <h1 class="page-header__title">#{{ tag }}</h1>
    <p class="page-header__description">{{ taggedEntries.length }} entrée{% if taggedEntries.length > 1 %}s{% endif %}</p>
  </header>

  <div class="entry-list">
    {% for entry in collections.entries %}
      {% if tag in (entry.data.tags or []) %}
        {% include "components/entry-card.njk" %}
      {% endif %}
    {% endfor %}
  </div>

  <div style="margin-top: var(--space-12);">
    <h2 style="font-size: var(--text-lg); margin-bottom: var(--space-4); color: var(--text-secondary);">Tous les tags</h2>
    <div class="tags-filter">
      {% for tagName in collections.tagList %}
        <a href="/tags/{{ tagName | slugify }}/" class="tag {% if tagName == tag %}tag--active{% endif %}">{{ tagName }}</a>
      {% endfor %}
    </div>
  </div>
</div>
