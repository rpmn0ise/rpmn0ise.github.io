---
layout: base.njk
title: Notes
description: Notes rapides, découvertes et pensées non finies.
permalink: /notes/
---

<div class="container">

  <header class="page-header">
    <p class="page-header__eyebrow">Fragments &amp; découvertes rapides</p>
    <h1 class="page-header__title">Notes</h1>
    <p class="page-header__description">{{ description }}</p>
  </header>

  {% set noteEntries = collections.entries | where("data.entryType", "note") %}
  {% if noteEntries.length %}
    <div class="entry-list">
      {% for entry in noteEntries %}
        {% include "components/entry-card.njk" %}
      {% endfor %}
    </div>
  {% else %}
    <p style="color: var(--text-secondary); padding: var(--space-12) 0; text-align: center;">Aucune note pour l'instant.</p>
  {% endif %}

</div>
