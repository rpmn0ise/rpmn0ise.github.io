---
layout: base.njk
title: Blog
description: Articles sur le développement web, les outils, les expériences et les réflexions techniques.
pagination:
  data: collections.posts
  size: 10
  alias: posts
permalink: "{% if pagination.pageNumber == 0 %}/blog/{% else %}/blog/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---

<div class="container">

  <header class="blog-header">
    <h1 class="blog-title">Blog</h1>
    <p class="blog-description">{{ description }}</p>
  </header>

  {# Search #}
  <div class="search-box" role="search">
    <svg class="search-box__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input
      type="search"
      id="search-input"
      placeholder="Rechercher un article…"
      aria-label="Rechercher dans les articles"
      autocomplete="off"
    >
  </div>

  {# Tags #}
  {% if collections.tagList.length %}
    <div class="tags-filter" role="navigation" aria-label="Filtrer par tag">
      <a href="/blog/" class="tag {% if not tag %}tag--active{% endif %}">Tous</a>
      {% for tagName in collections.tagList %}
        <a href="/tags/{{ tagName | slugify }}/" class="tag">{{ tagName }}</a>
      {% endfor %}
    </div>
  {% endif %}

  {# Posts list #}
  <div class="blog-list" id="posts-list">
    {% for post in posts %}
      <article
        class="post-list-item"
        data-search-item="{{ post.data.title }} {{ post.data.description }} {{ post.data.tags | join(' ') }}"
      >
        <time class="post-list-item__date" datetime="{{ post.date | htmlDateString }}">
          {{ post.date | readableDate("dd MMM yyyy") }}
        </time>

        <div class="post-list-item__body">
          <h2 class="post-list-item__title">
            <a href="{{ post.url }}">{{ post.data.title }}</a>
          </h2>
          {% if post.data.description %}
            <p class="post-list-item__description">{{ post.data.description }}</p>
          {% endif %}
        </div>

        {% if post.data.tags %}
          <div class="post-list-item__tags">
            {% for t in post.data.tags %}
              {% if t != "post" and t != "posts" %}
                <a href="/tags/{{ t | slugify }}/" class="tag">{{ t }}</a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </article>
    {% else %}
      <p>Aucun article publié pour l'instant.</p>
    {% endfor %}

    <p id="no-results" hidden style="color: var(--text-secondary); padding: var(--space-8); text-align:center;">
      Aucun résultat pour cette recherche.
    </p>
  </div>

  {# Pagination #}
  {% include "components/pagination.njk" %}

</div>
