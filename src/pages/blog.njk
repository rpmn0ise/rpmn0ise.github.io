---
layout: base.njk
title: Le Labo
description: Tout ce qui a été exploré, construit, cassé, compris.
pagination:
  data: collections.entries
  size: 15
  alias: entries
permalink: "{% if pagination.pageNumber == 0 %}/blog/{% else %}/blog/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---

<div class="container">

  <header class="page-header">
    <p class="page-header__eyebrow">Journal complet du labo</p>
    <h1 class="page-header__title">Le Labo</h1>
    <p class="page-header__description">{{ description }}</p>
  </header>

  <div class="search-box" role="search" style="margin-bottom: var(--space-6);">
    <svg class="search-box__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input
      type="search"
      id="search-input"
      placeholder="Rechercher dans le labo…"
      aria-label="Rechercher dans le labo"
      autocomplete="off"
    >
  </div>

  <div class="filters">
    <div class="filters__row">
      <span class="filters__label">Domaine</span>
      <a href="#" class="tag tag--active" data-domain-filter="tous">Tous</a>
      {% for domain in collections.domainStats %}
        <a href="#" class="tag" data-domain-filter="{{ domain.id }}">{{ domain.label }}</a>
      {% endfor %}
    </div>
    <div class="filters__row">
      <span class="filters__label">Type</span>
      <a href="#" class="tag tag--active" data-type-filter="tous">Tout</a>
      <a href="#" class="tag" data-type-filter="article">Articles</a>
      <a href="#" class="tag" data-type-filter="note">Notes</a>
      <a href="#" class="tag" data-type-filter="projet">Projets</a>
    </div>
  </div>

  <div class="entry-list" id="entries-list">
    {% for entry in entries %}
      {% include "components/entry-card.njk" %}
    {% else %}
      <p style="color: var(--text-secondary); padding: var(--space-8) 0;">Aucune entrée pour l'instant.</p>
    {% endfor %}

    <p id="no-results" hidden style="color: var(--text-secondary); padding: var(--space-8) 0; text-align:center;">
      Aucun résultat pour cette recherche.
    </p>
  </div>

  {% include "components/pagination.njk" %}

</div>
