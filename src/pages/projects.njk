---
layout: base.njk
title: Projets
description: Ce qui a été conçu, testé, mesuré et documenté — labo par labo.
permalink: /projects/
---

<div class="container">

  <header class="page-header">
    <p class="page-header__eyebrow">Établi — ce qui est construit</p>
    <h1 class="page-header__title">Projets</h1>
    <p class="page-header__description">{{ description }}</p>
  </header>

  {% if collections.projects.length %}
    <div class="entry-list">
      {% for project in collections.projects %}
        {% set entry = project %}
        {% include "components/entry-card.njk" %}
      {% endfor %}
    </div>
  {% else %}
    <p style="color: var(--text-secondary); padding: var(--space-16) 0; text-align: center;">
      Projets en cours de rédaction…
    </p>
  {% endif %}

</div>
