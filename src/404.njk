---
layout: base.njk
pagination:
  data: langues
  size: 1
  alias: L
permalink: "{{ i18n[L].routes.erreur }}"
eleventyComputed:
  lang: "{{ L }}"
  title: "{{ i18n[L].pages.erreur.titre }}"
noindex: true
eleventyExcludeFromCollections: true
---
{%- set e = t.pages.erreur %}
<header class="entete-contenu erreur">
  <p class="meta">{{ e.code }}<span data-erreur-chemin></span></p>
  <h1 data-erreur-titre>{{ e.titreDefaut }}</h1>
  <p class="chapo" data-erreur-texte>{{ e.texteDefaut }}</p>
</header>
<p class="erreur__actions">
  <a href="{{ t.routes.accueil }}">{{ e.retour }}</a>
  <button class="bouton-plus" type="button" data-erreur-autre hidden>{{ e.autre }}</button>
</p>
{%- set messages = erreurs404 | listeLoc(lang) %}
{%- if messages.length %}
<script type="application/json" id="erreurs404-donnees">{{ messages | dump | replace("<", "\\u003c") | safe }}</script>
<script>
(function () {
  var el = document.getElementById("erreurs404-donnees");
  var titre = document.querySelector("[data-erreur-titre]");
  var texte = document.querySelector("[data-erreur-texte]");
  var chemin = document.querySelector("[data-erreur-chemin]");
  var bouton = document.querySelector("[data-erreur-autre]");
  if (!el || !titre || !texte) return;
  var liste;
  try { liste = JSON.parse(el.textContent); } catch (e) { return; }
  if (!Array.isArray(liste) || !liste.length) return;
  var dernier = -1;
  try { dernier = parseInt(sessionStorage.getItem("erreur404"), 10); } catch (e) {}
  function tirer() {
    var i;
    do { i = Math.floor(Math.random() * liste.length); } while (liste.length > 1 && i === dernier);
    dernier = i;
    try { sessionStorage.setItem("erreur404", String(i)); } catch (e) {}
    titre.textContent = liste[i].titre;
    texte.textContent = liste[i].texte;
  }
  tirer();
  if (chemin && location.pathname && location.pathname !== "/" && location.pathname !== "/en/") chemin.textContent = " · " + location.pathname;
  if (bouton && liste.length > 1) { bouton.hidden = false; bouton.addEventListener("click", tirer); }
})();
</script>
{%- endif %}
