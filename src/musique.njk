---
layout: base.njk
pagination:
  data: langues
  size: 1
  alias: L
  addAllPagesToCollections: true
permalink: "{{ i18n[L].routes.musique }}"
eleventyComputed:
  lang: "{{ L }}"
  translationKey: musique-index
  title: "{{ i18n[L].pages.musique.titre }}"
  description: "{{ i18n[L].pages.musique.description }}"
---
{%- set m = t.pages.musique %}
<header class="entete-contenu">
  <h1>{{ m.titre }}</h1>
  <p class="chapo">{{ m.chapo }}</p>
</header>

<section class="bloc">
  <div class="bloc__tete">
    <h2 class="section-titre">{{ m.enCeMoment }}</h2>
    <a class="suite" href="{{ musique.lastfm.profil }}" rel="noopener">{{ m.profilLastfm }}</a>
  </div>
  {%- set grand = true %}{%- set nombre = 9 %}{%- set liste = true %}
  {% include "ecoute.njk" %}
  <p class="vide" data-ecoute-vide hidden>{{ m.vide }}</p>
  <noscript><p class="vide">{{ m.sansJs }} <a href="{{ musique.lastfm.profil }}" rel="noopener">Last.fm</a>.</p></noscript>
</section>

{%- if musique.selection.length %}
<section class="bloc">
  <div class="bloc__tete">
    <h2 class="section-titre">{{ m.coupsDeCoeur }}</h2>
  </div>
  <ul class="liste liste--journal">
    {%- for x in musique.selection %}
    <li class="ligne">
      <p class="meta">{{ x.artiste }}</p>
      <div class="ligne__corps">
        {%- if x.url %}<a class="ligne__titre" href="{{ x.url }}" rel="noopener">{{ x.titre }}</a>{%- else %}<p class="ligne__titre">{{ x.titre }}</p>{%- endif %}
        {%- if x.note %}<p class="ligne__desc">{{ x.note | loc(lang) }}</p>{%- endif %}
      </div>
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

{%- if musique.playlist.url %}
<section class="bloc">
  <div class="bloc__tete">
    <h2 class="section-titre">{{ m.spotify }}</h2>
  </div>
  <a class="lien-grand" href="{{ musique.playlist.url }}" rel="noopener">
    <span class="lien-grand__corps">
      <span class="lien-grand__texte">{{ musique.playlist.titre }}</span>
      {%- if musique.playlist.note %}<span class="lien-grand__sous">{{ musique.playlist.note | loc(lang) }}</span>{%- endif %}
    </span>
    <span class="lien-grand__fleche" aria-hidden="true">↗</span>
  </a>
</section>
{%- endif %}

<section class="bloc">
  <div class="bloc__tete">
    <h2 class="section-titre">{{ m.soundcloud }}</h2>
  </div>
  <a class="lien-grand" href="{{ musique.soundcloud }}" rel="noopener">
    <span class="lien-grand__corps">
      <span class="lien-grand__texte">{{ m.soundcloudTexte }}</span>
    </span>
    <span class="lien-grand__fleche" aria-hidden="true">↗</span>
  </a>
</section>

{#- Masqué tant que Last.fm n'a pas répondu ; en dernier pour ne pas décaler la numérotation des autres sections. #}
<section class="bloc" data-classements-section hidden>
  <div class="bloc__tete">
    <h2 class="section-titre">{{ m.classements }}</h2>
    <a class="suite" href="{{ musique.lastfm.profil }}" rel="noopener">{{ m.dApresLastfm }}</a>
  </div>
  <div class="classements" data-classements data-utilisateur="{{ musique.lastfm.utilisateur }}" data-cle="{{ musique.lastfm.cle }}"></div>
</section>
