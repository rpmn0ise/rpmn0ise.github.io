---
layout: base.njk
---
<article>
  <header class="entete-contenu">
    <h1>{{ title }}</h1>
    <p class="chapo">{{ description }}</p>
    {%- if status or year or (tech and tech.length) or github or demo %}
    <dl class="fiche">
      {%- if status %}
      <div><dt>{{ t.projet.statut }}</dt><dd><span class="statut statut--{{ status }}">{{ status | statut(lang) }}</span></dd></div>
      {%- endif %}
      {%- if year %}
      <div><dt>{{ t.projet.annee }}</dt><dd>{{ year }}</dd></div>
      {%- endif %}
      {%- if tech and tech.length %}
      <div><dt>{{ t.projet.technologies }}</dt><dd>{{ tech | join(", ") }}</dd></div>
      {%- endif %}
      {%- if github or demo %}
      <div><dt>{{ t.projet.liens }}</dt><dd>
        {%- if github %}<a href="{{ github }}">{{ t.projet.code }}</a>{% endif %}
        {%- if demo %}<a href="{{ demo }}">{{ t.projet.demo }}</a>{% endif %}
      </dd></div>
      {%- endif %}
    </dl>
    {%- endif %}
  </header>

  <div class="prose">
    {{ content | safe }}
  </div>
</article>
